# Copiar a .env (no se sube a git) para correr scripts/db.mjs y `netlify dev`.
# En Netlify estas mismas variables van en Site configuration → Environment variables.

# La conexión de Neon (Connect → Connection string)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Un texto largo al azar para firmar la cookie de sesión. Se genera con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
